# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Model directories
CHARTDETE_HF_DIR=/data/appls/machine_learning/AEM_OCR/huggingface
LINEFORMER_HF_DIR=/data/appls/machine_learning/AEM_OCR/huggingface

# LLM provider
# Choose one:
# AEM_OCR_LLM_PROVIDER=openai
# AEM_OCR_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

AEM_OCR_LLM_PROVIDER=ollama
AEM_OCR_LLM_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434

# Remote chemical editor helper
# If users access the app remotely and use the chemical drawing tool,
# these settings make the helper HTTP server browser-reachable.
AEM_OCR_JSME_BIND_HOST=127.0.0.1
AEM_OCR_JSME_PORT=8765
AEM_OCR_JSME_PUBLIC_URL=https://aem-ocr.example.org/jsme-assets
