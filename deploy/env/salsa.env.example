# Streamlit
STREAMLIT_SERVER_PORT=8601
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=500
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# Production should not restart just because source files changed during
# development. Restart salsa.service deliberately after testing changes.
STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
STREAMLIT_SERVER_RUN_ON_SAVE=false

# Model directories
CHARTDETE_HF_DIR=/data/appls/machine_learning/SALSA/huggingface
LINEFORMER_HF_DIR=/data/appls/machine_learning/SALSA/huggingface

# LLM provider
# Choose one:
# SALSA_LLM_PROVIDER=openai
# SALSA_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

SALSA_LLM_PROVIDER=ollama
SALSA_LLM_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434
SALSA_OLLAMA_NUM_CTX=16384

# User profiles and password reset
SALSA_DATA_ROOT=/data/appls/machine_learning/SALSA/src/ui_runs
SALSA_AUTH_DB=/data/appls/machine_learning/SALSA/src/ui_runs/auth.sqlite3
SALSA_PUBLIC_URL=https://salsa.example.org
SALSA_AUTH_ALLOW_SIGNUP=true
# Georgia Tech campus relay for password-reset tokens and admin notifications.
# The hostname must be registered on Georgia Tech's Authorized Senders list.
SALSA_SMTP_HOST=outbound.mail.gatech.edu
SALSA_SMTP_PORT=25
SALSA_SMTP_LOCAL_HOSTNAME=polymergenome.storm.gatech.edu
# Use a valid Georgia Tech mailbox. Unregistered subdomain senders are rejected.
SALSA_SMTP_FROM=your-account@gatech.edu
SALSA_SMTP_TLS=0
# Authenticated relays may additionally set:
# SALSA_SMTP_USERNAME=salsa@example.org
# SALSA_SMTP_PASSWORD=change-me
# Internal-only fallback: print reset tokens to `journalctl -u salsa` logs.
# SALSA_AUTH_PRINT_RESET_LINKS=1

# Publisher machine-access credentials
# DOI redirects only locate landing pages; they do not grant TDM/full-text access.
# ELSEVIER_API_KEY=...
# WILEY_API_KEY=...
# SPRINGER_NATURE_API_KEY=...
# RSC_API_KEY=...
# NCBI_API_KEY=...
# IEEE_API_KEY=...

# Remote chemical editor helper
# If users access the app remotely and use the chemical drawing tool,
# these settings make the helper HTTP server browser-reachable.
SALSA_JSME_BIND_HOST=127.0.0.1
SALSA_JSME_PORT=8765
SALSA_JSME_PUBLIC_URL=https://salsa.example.org/jsme-assets
