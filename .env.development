# Streamlit development app
STREAMLIT_SERVER_PORT=8602
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=500
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_FILE_WATCHER_TYPE=auto
STREAMLIT_SERVER_RUN_ON_SAVE=true

# Keep development runs and auth separate from production.
SALSA_APP_ENV=development
SALSA_DATA_ROOT=/home/wschertzer3/SALSA/src/ui_runs_dev
SALSA_AUTH_DB=/home/wschertzer3/SALSA/src/ui_runs_dev/auth.sqlite3
SALSA_PUBLIC_URL=http://localhost:8602
SALSA_AUTH_ALLOW_SIGNUP=true

# Use the model snapshot available in this development checkout.
CHARTDETE_HF_DIR=/home/wschertzer3/SALSA/huggingface
LINEFORMER_HF_DIR=/home/wschertzer3/SALSA/huggingface

# LLM provider
SALSA_LLM_PROVIDER=ollama
SALSA_LLM_MODEL=gemma4
OLLAMA_HOST=http://127.0.0.1:11435
SALSA_OLLAMA_NUM_CTX=16384

# Optional SMTP for development notifications.
# SALSA_SMTP_HOST=outbound.mail.gatech.edu
# SALSA_SMTP_PORT=25
# SALSA_SMTP_LOCAL_HOSTNAME=polymergenome.storm.gatech.edu
# SALSA_SMTP_FROM=your-account@gatech.edu
# SALSA_SMTP_TLS=0

# Publisher machine-access credentials for development.
# ELSEVIER_API_KEY=...
# WILEY_API_KEY=...
# SPRINGER_NATURE_API_KEY=...
# RSC_API_KEY=...
# NCBI_API_KEY=...
# IEEE_API_KEY=...

# Docling runs in a Python 3.10 sidecar because the main SALSA environment is Python 3.8.
DOCLING_PYTHON=/home/wschertzer3/miniconda3/envs/salsa-docling/bin/python
