# Streamlit
STREAMLIT_SERVER_PORT=8601
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=500
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_BASE_URL_PATH=

# User profiles and password reset
SALSA_DATA_ROOT=/home/wschertzer3/SALSA/src/ui_runs
SALSA_AUTH_DB=/home/wschertzer3/SALSA/src/ui_runs/auth.sqlite3
SALSA_PUBLIC_URL=https://salsa.storm.gatech.edu
SALSA_AUTH_ALLOW_SIGNUP=true
# SMTP relay for SALSA notifications and forgotten-password links.
SALSA_SMTP_HOST=outbound.mail.gatech.edu
SALSA_SMTP_PORT=25
SALSA_SMTP_LOCAL_HOSTNAME=polymergenome.storm.gatech.edu
SALSA_SMTP_FROM=no-reply@polymergenome.org
SALSA_SMTP_TLS=0
# Internal fallback: write reset links to `journalctl -u salsa` logs if SMTP is unavailable.
SALSA_AUTH_PRINT_RESET_LINKS=0


# Model directories
CHARTDETE_HF_DIR=/home/wschertzer3/SALSA/huggingface
LINEFORMER_HF_DIR=/home/wschertzer3/SALSA/huggingface

# LLM provider
# Choose one:
# SALSA_LLM_PROVIDER=openai
# SALSA_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Publisher TDM keys
# ELSEVIER_API_KEY=...
# WILEY_TDM_TOKEN=...

SALSA_LLM_PROVIDER=ollama
SALSA_LLM_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434
SALSA_OLLAMA_NUM_CTX=16384

# Remote chemical editor helper
# If users access the app remotely and use the chemical drawing tool,
# these settings make the helper HTTP server browser-reachable.
SALSA_JSME_BIND_HOST=0.0.0.0
SALSA_JSME_PORT=8765
SALSA_JSME_PUBLIC_URL=https://salsa.storm.gatech.edu/jsme-assets

# path to conda env that hosts docling
DOCLING_PYTHON=/home/wschertzer3/miniconda3/envs/salsa-docling/bin/python
