# Streamlit
STREAMLIT_SERVER_PORT=8601
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_BASE_URL_PATH=


# Model directories
CHARTDETE_HF_DIR=/home/wschertzer3/SALSA/huggingface
LINEFORMER_HF_DIR=/home/wschertzer3/SALSA/huggingface

# LLM provider
# Choose one:
# SALSA_LLM_PROVIDER=openai
# SALSA_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

SALSA_LLM_PROVIDER=ollama
SALSA_LLM_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434
SALSA_OLLAMA_NUM_CTX=16384

# Remote chemical editor helper
# If users access the app remotely and use the chemical drawing tool,
# these settings make the helper HTTP server browser-reachable.
SALSA_JSME_BIND_HOST=0.0.0.0
SALSA_JSME_PORT=8765
SALSA_JSME_PUBLIC_URL=https://salsa.storm.gatech.edu/jsme-assets
