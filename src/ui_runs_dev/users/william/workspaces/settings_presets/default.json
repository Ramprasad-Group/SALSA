  "custom_instructions": {
    "table_extraction_rules": "- If a parent header spans multiple columns, and there is a second header row that contains labels such as \"Before\" / \"After\", \"30\u00b0C\" / \"80\u00b0C\", \"Cal.\"/\"Exp\", \"in-plane\"/\"through-plane\", etc., you MUST factor them into final column headers.",
